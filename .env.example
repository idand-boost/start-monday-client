# Copy this file to .env and fill in what you need. Never commit .env.

# Your personal monday API token (avatar > Developers > My access tokens). Keep it secret.
# No VITE_ prefix on purpose: Vite sends anything starting with VITE_ to the browser.
# Only the dev server reads it (vite-plugins/monday-dev-api.ts), and only in `npm run dev`.
MONDAY_API_TOKEN=

# A test board and item, used only in a plain browser tab (npm run dev).
# Inside monday the app reads them from monday's context. Not secrets:
# the board id is the number after /boards/ in the URL, the item id the number after /pulses/.
VITE_DEV_BOARD_ID=
VITE_DEV_ITEM_ID=

# Optional, for when you add a backend (track 3). In a plain tab the SDK mock hands these
# to getSessionToken() and getBackendUrl() (src/lib/monday/session.ts).
VITE_DEV_TOKEN=
VITE_DEV_BACKEND_URL=http://localhost:8080
